<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:paddingHorizontal="16dp"
    android:background="?attr/selectableItemBackground">

    <!-- Flag emoji -->
    <TextView
        android:id="@+id/tvFlag"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:textSize="22sp"
        android:fontFamily="@font/baloo2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/bg_flag" />

    <!-- Language name -->
    <TextView
        android:id="@+id/tvLangName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="@font/baloo2"
        android:textColor="@color/text_color"
        app:layout_constraintStart_toEndOf="@id/tvFlag"
        app:layout_constraintEnd_toStartOf="@id/radioBtn"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvNative" />

    <TextView
        android:id="@+id/tvNative"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:textSize="12sp"
        android:fontFamily="@font/baloo2"
        android:textColor="@color/gray_400"
        app:layout_constraintStart_toEndOf="@id/tvFlag"
        app:layout_constraintEnd_toStartOf="@id/radioBtn"
        app:layout_constraintTop_toBottomOf="@id/tvLangName"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Custom radio -->
    <ImageView
        android:id="@+id/radioBtn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_radio_unselect"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>