<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_activity"
    tools:context=".ui.activity.CreatePostActivity">

    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="TextSizeCheck">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/baloo2"
            android:text="@string/create_a_new_post"
            android:textColor="@color/text_orange"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:ignore="RelativeOverlap,TextContrastCheck" />

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_close"
            tools:ignore="TouchTargetSizeCheck" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_post"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/images_videos"
                android:textStyle="bold"
                android:textSize="18sp"
                android:fontFamily="@font/baloo2"
                android:textColor="#000000"
                android:layout_marginBottom="8dp"/>

            <FrameLayout
                android:id="@+id/btn_add_media"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@drawable/bg_dashed_orange"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_add"
                    app:tint="#FF8A65"
                    tools:ignore="ImageContrastCheck" />
            </FrameLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_media_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:ignore="SpeakableTextPresentCheck"
                tools:listitem="@layout/item_media_preview" />

            <TextView
                android:id="@+id/btn_edit_media"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit_media"
                android:textColor="#FF7043"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginBottom="24dp"
                app:drawableEndCompat="@drawable/ic_edit"
                app:drawableTint="#FF7043" />

            <com.nvv.petber.ui.mention.MentionEditText
                android:id="@+id/et_caption"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_edittext_gray"
                android:fontFamily="@font/baloo2"
                android:gravity="top"
                android:hint="@string/hint_caption"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:padding="16dp"
                android:textSize="14sp"
                tools:ignore="TextContrastCheck,VisualLintTextFieldSize" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tag_your_pet"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="18sp"
                android:fontFamily="@font/baloo2"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_pets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:chipSpacingHorizontal="7dp">

                <com.google.android.material.chip.Chip
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pet1"
                    android:fontFamily="@font/baloo2"
                    app:chipBackgroundColor="#F5EFE1"
                    app:closeIconVisible="false"
                    app:chipCornerRadius="20dp"
                    app:chipStrokeWidth="0dp"
                    tools:ignore="HardcodedText" />

            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hashtags"
                android:textStyle="bold"
                android:textSize="18sp"
                android:fontFamily="@font/baloo2"
                android:textColor="#000000"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/et_hashtags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:background="@drawable/bg_edittext_gray"
                android:fontFamily="@font/baloo2"
                android:hint="@string/hint_hashtags"
                android:importantForAutofill="no"
                android:inputType="text"
                android:padding="12dp"
                android:textSize="14sp"
                tools:ignore="TextContrastCheck,TouchTargetSizeCheck,VisualLintTextFieldSize" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_post"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/baloo2"
        android:text="@string/post_now"
        android:textColor="#F6F5F5"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="#FF7043"
        app:cornerRadius="26dp"
        app:icon="@drawable/ic_send"
        app:iconGravity="textEnd"
        app:iconTint="#FFFFFF"
        tools:ignore="TextContrastCheck,VisualLintButtonSize"
        app:layout_constraintBottom_toBottomOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>