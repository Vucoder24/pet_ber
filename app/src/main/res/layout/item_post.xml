<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#F0EDED"
    app:cardElevation="2dp">

    <LinearLayout
        android:id="@+id/layoutContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:animateLayoutChanges="true"
        android:padding="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgUser"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_launcher_background"
                app:shapeAppearanceOverlay="@style/CircleImage"
                tools:ignore="ImageContrastCheck" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_toEndOf="@id/imgUser"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Username"
                    android:textStyle="bold"
                    android:fontFamily="@font/baloo2"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvTimeAgo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="time"
                    android:textSize="12sp"
                    android:fontFamily="@font/baloo2"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/btn_icon_background"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_more"
                app:tint="@color/text_brown"
                tools:ignore="ImageContrastCheck,TouchTargetSizeCheck" />

        </RelativeLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/containerMedia"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerViewSingle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="false"
                app:resize_mode="zoom"
                android:visibility="gone" />


            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivSingleImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/Rounded12"
                android:visibility="gone" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutMediaGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:background="@drawable/bg_rounded_12">

                <ImageView
                    android:id="@+id/ivGrid1"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginEnd="1dp"
                    android:layout_marginBottom="1dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toTopOf="@+id/ivGrid3"
                    app:layout_constraintEnd_toStartOf="@+id/ivGrid2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/ivGrid2"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="1dp"
                    android:layout_marginBottom="1dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toTopOf="@+id/ivGrid4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ivGrid1"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/ivGrid3"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="1dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ivGrid4"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivGrid1" />

                <ImageView
                    android:id="@+id/ivGrid4"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="1dp"
                    android:layout_marginTop="1dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ivGrid3"
                    app:layout_constraintTop_toBottomOf="@+id/ivGrid2" />

                <ImageView
                    android:id="@+id/icPlay1"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:importantForAccessibility="no"
                    android:src="@android:drawable/ic_media_play"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/ivGrid1"
                    app:layout_constraintEnd_toEndOf="@+id/ivGrid1"
                    app:layout_constraintStart_toStartOf="@+id/ivGrid1"
                    app:layout_constraintTop_toTopOf="@+id/ivGrid1" />

                <ImageView
                    android:id="@+id/icPlay2"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:importantForAccessibility="no"
                    android:src="@android:drawable/ic_media_play"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/ivGrid2"
                    app:layout_constraintEnd_toEndOf="@+id/ivGrid2"
                    app:layout_constraintStart_toStartOf="@+id/ivGrid2"
                    app:layout_constraintTop_toTopOf="@+id/ivGrid2" />

                <ImageView
                    android:id="@+id/icPlay3"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:importantForAccessibility="no"
                    android:src="@android:drawable/ic_media_play"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/ivGrid3"
                    app:layout_constraintEnd_toEndOf="@+id/ivGrid3"
                    app:layout_constraintStart_toStartOf="@+id/ivGrid3"
                    app:layout_constraintTop_toTopOf="@+id/ivGrid3" />

                <ImageView
                    android:id="@+id/icPlay4"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:importantForAccessibility="no"
                    android:src="@android:drawable/ic_media_play"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/ivGrid4"
                    app:layout_constraintEnd_toEndOf="@+id/ivGrid4"
                    app:layout_constraintStart_toStartOf="@+id/ivGrid4"
                    app:layout_constraintTop_toTopOf="@+id/ivGrid4" />


                <FrameLayout
                    android:id="@+id/overlayMore"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="#80000000"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@id/ivGrid4"
                    app:layout_constraintEnd_toEndOf="@id/ivGrid4"
                    app:layout_constraintStart_toStartOf="@id/ivGrid4"
                    app:layout_constraintTop_toTopOf="@id/ivGrid4">

                    <TextView
                        android:id="@+id/tvMoreCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="@android:color/white"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <ProgressBar
                android:id="@+id/pbLoadingSingle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/text_orange"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/icPlaySingle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_btn"
                android:importantForAccessibility="no"
                android:visibility="gone"
                app:tint="@color/white" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="caption"
            android:maxLines="3"
            android:ellipsize="end"
            android:textStyle="normal"
            android:fontFamily="@font/baloo2"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/hashtags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/baloo2"
            android:text="@string/hashtags"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_orange"
            android:textStyle="bold"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_like"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_like" />

            <TextView
                android:id="@+id/tvLikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="120"
                android:fontFamily="@font/baloo2"
                android:layout_marginEnd="16dp"
                tools:ignore="HardcodedText" />

            <ImageView
                android:id="@+id/btn_cmt"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_cmt" />

            <TextView
                android:id="@+id/tvCmtCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="16dp"
                android:text="25"
                android:fontFamily="@font/baloo2"
                tools:ignore="HardcodedText" />

            <ImageView
                android:id="@+id/btn_share"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_share" />

            <TextView
                android:id="@+id/tvShareCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="0"
                android:fontFamily="@font/baloo2"
                tools:ignore="HardcodedText" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>