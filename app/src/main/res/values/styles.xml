<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="BottomNavLabelInactive" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/nav_label_size</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/baloo2</item>
    </style>

    <style name="BottomNavLabelActive" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/nav_label_size_active</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/baloo2</item>
    </style>
    <style name="CircleImage" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="Rounded12" parent="">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="CustomTabText" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/baloo2</item>
    </style>

    <style name="CardTopRounded">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="PetBerDatePickerTheme" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/pet_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/pet_card</item>
        <item name="colorOnSurface">@color/pet_text_primary</item>
    </style>

    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/pet_accent</item>
        <item name="hintTextColor">@color/pet_accent</item>
        <item name="endIconTint">@color/pet_accent</item>
    </style>

</resources>